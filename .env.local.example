# Resend (transactional email for the contact form)
RESEND_API_KEY=

# Supabase (auth + database)
# Project URL and anon/publishable key: Supabase dashboard -> Settings -> API
# These two are safe to expose to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role/secret key: same page, but NEVER expose this to the
# browser or commit it. Only needed for the admin invite UI.
SUPABASE_SERVICE_ROLE_KEY=
